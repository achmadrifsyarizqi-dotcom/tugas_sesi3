const readline = require('readline');

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});


const daftarBarang = {
    1: { nama: "Buku Tulis", harga: 25000 },
    2: { nama: "Pensil 2B", harga: 13000 },
    3: { nama: "Penggaris", harga: 24000 },
    4: { nama: "Penghapus", harga: 12000 },
    5: { nama: "Tipe-X", harga: 37000 }
};

let totalBelanja = 0;
let jumlahItem = 0;

console.log("=== DAFTAR BARANG ===");
for (let id in daftarBarang) {
    console.log(`${id}. ${daftarBarang[id].nama} - Rp${daftarBarang[id].harga}`);
}
console.log("=====================");

function pilihBarang() {
    rl.question(`Masukkan nomor pilihan barang ke-${jumlahItem + 1}: `, (jawaban) => {
        let pilihan = parseInt(jawaban);

        
        switch (pilihan) {
            case 1:
                totalBelanja += daftarBarang[1].harga;
                console.log(`> Ditambahkan: ${daftarBarang[1].nama}`);
                break;
            case 2:
                totalBelanja += daftarBarang[2].harga;
                console.log(`> Ditambahkan: ${daftarBarang[2].nama}`);
                break;
            case 3:
                totalBelanja += daftarBarang[3].harga;
                console.log(`> Ditambahkan: ${daftarBarang[3].nama}`);
                break;
            case 4:
                totalBelanja += daftarBarang[4].harga;
                console.log(`> Ditambahkan: ${daftarBarang[4].nama}`);
                break;
            case 5:
                totalBelanja += daftarBarang[5].harga;
                console.log(`> Ditambahkan: ${daftarBarang[5].nama}`);
                break;
            default:
                console.log("> Pilihan tidak valid, silakan coba lagi.");
                return pilihBarang();
        }

        jumlahItem++;

        

        if (jumlahItem < 3) {
            pilihBarang();
        } else {
            rl.question("Apakah ingin menambah barang lagi? (y/n): ", (jawab) => {
                if (jawab.toLowerCase() === 'y') {
                    pilihBarang();
                } else {
                    hitungDanTampilkanRincian();
                    rl.close();
                }
            });
        }
    });
}

function hitungDanTampilkanRincian() {
    let diskonPersen = 0;

    
    if (totalBelanja >= 300000) {
    } else if (totalBelanja >= 100000) {
        diskonPersen = 0.05; // 5%
    } else if (totalBelanja >= 50000) {
        diskonPersen = 0.03; // 3%
    }

    
    let totalDiskon = totalBelanja * diskonPersen;

    
    let totalBayar = totalBelanja - totalDiskon;

    console.log("\n================ RINCIAN PEMBAYARAN ================");
    
    
    if (totalDiskon > 0) {
        console.log(`Total Belanja : Rp${totalBelanja}`);
        console.log(`Diskon        : Rp${totalDiskon}`);
        console.log(`Total Bayar   : Rp${totalBayar}`);
    } else {
        console.log(`Total Belanja : Rp${totalBelanja}`);
        console.log("Anda tidak mendapat diskon karena tidak mencapai minimum pembelanjaan");
    }
    console.log("====================================================");
}


pilihBarang();
